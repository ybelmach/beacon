# Fixed settings for the test suite. Selected via BEACON_ENV_FILE in conftest.py so a
# developer's real .env can never change how tests behave. Real environment variables
# still win over this file, so CI can override any single value.

APP_NAME=beacon-backend
SERVICE_NAME=backend
ENVIRONMENT=test
BASE_URL=http://testserver
DEBUG_MODE=false
ENABLE_DOCS=true
LOG_LEVEL=WARNING
LOG_FORMAT=json

CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
READINESS_TIMEOUT_SECONDS=2.0

SECRET_KEY=test-secret-key

POSTGRES_DSN=postgresql+asyncpg://beacon:beacon@localhost:5432/beacon

REDIS_DSN=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=beacon-artifacts

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=beacon
CLICKHOUSE_PASSWORD=beacon
CLICKHOUSE_DB=beacon

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=telemetry.events
KAFKA_TOPIC_DLQ=telemetry.dlq
KAFKA_CONSUMER_GROUP=storage
