root = true

[*]
indent_style = space
indent_size = 4
max_line_length = 200
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4
max_line_length = 121

[*.md]
trim_trailing_whitespace = false

[*.{html,css,scss}]
indent_size = 2

[*.{js,jsx,ts,tsx}]
indent_size = 2

[*.json]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

[*.sh]
indent_size = 4
