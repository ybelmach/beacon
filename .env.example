# App
APP_NAME=beacon-backend
SERVICE_NAME=backend
ENVIRONMENT=local
BASE_URL=http://localhost:18000
DEBUG_MODE=true
ENABLE_DOCS=true
LOG_LEVEL=INFO
# json | console – console is the human-readable dev renderer
LOG_FORMAT=console

# Comma-separated origins. Empty = CORS disabled.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Probes
READINESS_TIMEOUT_SECONDS=2.0

SECRET_KEY=change-me

# Postgres
POSTGRES_DB=beacon
POSTGRES_USER=beacon
POSTGRES_PASSWORD=beacon
EXTERNAL_POSTGRES_PORT=15432

# Redis
EXTERNAL_REDIS_PORT=16379

# S3 / MinIO
S3_ROOT_USER=minioadmin
S3_ROOT_PASSWORD=minioadmin
S3_BUCKET=beacon-artifacts
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# ClickHouse
CLICKHOUSE_DB=beacon
CLICKHOUSE_USER=beacon
CLICKHOUSE_PASSWORD=beacon
EXTERNAL_CLICKHOUSE_HTTP_PORT=18123
EXTERNAL_CLICKHOUSE_NATIVE_PORT=19009

# Kafka
EXTERNAL_KAFKA_PORT=19092
KAFKA_TOPIC_EVENTS=telemetry.events
KAFKA_TOPIC_DLQ=telemetry.dlq
KAFKA_CONSUMER_GROUP=storage

# Ports / observability
BACKEND_EXTERNAL_PORT=18000
BACKEND_INTERNAL_PORT=8000
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
KAFKA_UI_PORT=18080

# Simulator
SIM_DEVICES=1000
SIM_EPM=6
